{
  "expo": {
    "name": "Classic Garage",
    "slug": "classic-garage",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "classic-garage",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F2EE"
    },
    "ios": {
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Classic Garage uses your camera to photograph cars and receipts, and to scan VIN barcodes on dash or door stickers.",
        "NSPhotoLibraryUsageDescription": "Classic Garage uses your photo library for car photos and receipts."
      },
      "supportsTablet": true,
      "bundleIdentifier": "com.quiz.classicgarage",
      "buildNumber": "4"
    },
    "android": {
      "package": "com.quiz.classicgarage",
      "versionCode": 4,
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F4F2EE",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Classic Garage uses your camera to photograph cars and receipts, and to scan VIN barcodes on dash or door stickers.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Classic Garage uses your photo library for car photos and receipts.",
          "cameraPermission": "Classic Garage uses your camera to photograph cars and receipts, and to scan VIN barcodes on dash or door stickers.",
          "microphonePermission": false
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.47244320371-26iavacqibm5i1m7qlk7jrcr6tbu5ppl"
        }
      ],
      "expo-dev-client",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.5"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b027216f-fed2-4072-8c20-a2f537f648fe"
      }
    }
  }
}
